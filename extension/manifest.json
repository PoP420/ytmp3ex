{
  "manifest_version": 3,
  "name": "ytmp3ex",
  "version": "0.1.0",
  "description": "Download YouTube videos as MP3",
  "permissions": ["activeTab", "storage", "scripting", "downloads"],
  "host_permissions": ["https://www.youtube.com/*", "http://localhost:*/*"],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content/content.js"],
      "run_at": "document_end"
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
